{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "EZBEQConfig.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "Database ID (internal use only)"
        },
        "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable EzBEQ integration"
        },
        "url": {
            "type": "string",
            "default": "ezbeq.local",
            "examples": [
                "ezbeq.local"
            ],
            "pattern": "^[a-z0-9.-]+$|^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$",
            "description": "EzBEQ server hostname or IP address"
        },
        "port": {
            "type": "string",
            "default": "8080",
            "examples": [
                "8080"
            ],
            "description": "EzBEQ server port"
        },
        "scheme": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "http"
                },
                {
                    "type": "string",
                    "const": "https"
                }
            ],
            "default": "http",
            "description": "Connection protocol"
        },
        "avrBrand": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "Denon"
                },
                {
                    "type": "string",
                    "const": "Marantz"
                }
            ],
            "default": "Denon",
            "examples": [
                "Denon"
            ],
            "description": "AVR brand"
        },
        "avrURL": {
            "type": "string",
            "default": "",
            "examples": [
                "http://192.168.1.100"
            ],
            "pattern": "^https?://",
            "description": "AVR URL with protocol"
        },
        "denonIP": {
            "type": "string",
            "default": "",
            "examples": [
                "192.168.1.100"
            ],
            "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$|^[a-z0-9.-]+$",
            "description": "Denon AVR IP address"
        },
        "denonPort": {
            "type": "string",
            "default": "23",
            "examples": [
                "23"
            ],
            "description": "Denon AVR port"
        },
        "preferredAuthors": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Preferred BEQ authors. Select authors to allow. Leave empty to match any author"
        },
        "slots": {
            "type": "array",
            "items": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
            },
            "minItems": 0,
            "maxItems": 4,
            "description": "Profile slot numbers to load into"
        },
        "useAVRCodecSearch": {
            "type": "boolean",
            "default": false,
            "description": "Use AVR codec search for BEQ profiles"
        },
        "adjustMasterVolumeWithProfile": {
            "type": "boolean",
            "default": true,
            "description": "Adjust master volume with profile"
        },
        "enableTVBEQ": {
            "type": "boolean",
            "default": false,
            "description": "Enable TV BEQ profiles"
        },
        "looseEditionMatching": {
            "type": "boolean",
            "default": false,
            "description": "Match ANY edition IF your client sends a blank edition"
        },
        "skipEditionMatching": {
            "type": "boolean",
            "default": false,
            "description": "Skip edition matching entirely"
        },
        "stopPlexIfMismatch": {
            "type": "boolean",
            "default": false,
            "description": "Stop Plex playback if BEQ profile doesn't match"
        },
        "notifyOnLoad": {
            "type": "boolean",
            "default": false,
            "description": "Send notification when profile is loaded"
        },
        "notifyOnUnload": {
            "type": "boolean",
            "default": false,
            "description": "Send notification when profile is unloaded"
        },
        "dryRun": {
            "type": "boolean",
            "default": false,
            "description": "Enable dry run mode (no actual changes)"
        }
    },
    "required": [
        "enabled",
        "url",
        "port",
        "scheme",
        "avrBrand",
        "avrURL",
        "denonIP",
        "denonPort",
        "preferredAuthors",
        "slots",
        "useAVRCodecSearch",
        "adjustMasterVolumeWithProfile",
        "enableTVBEQ",
        "looseEditionMatching",
        "skipEditionMatching",
        "stopPlexIfMismatch",
        "notifyOnLoad",
        "notifyOnUnload",
        "dryRun"
    ],
    "description": "EzBEQ integration configuration"
}